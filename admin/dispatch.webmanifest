{
  "name": "Cargoworks Dispatch",
  "short_name": "CW Dispatch",
  "description": "Say or type an order and it is created in the dispatcher.",
  "id": "cw-dispatch",
  "start_url": "dispatcher.html?quick=1&mic=1",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ece8f2",
  "theme_color": "#f07b39",
  "icons": [
    { "src": "../img/cw-dispatch-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../img/cw-dispatch-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../img/cw-dispatch-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Type a note", "short_name": "Type", "url": "dispatcher.html?quick=1", "icons": [{ "src": "../img/cw-dispatch-192.png", "sizes": "192x192" }] },
    { "name": "Full dispatcher", "short_name": "Dispatcher", "url": "dispatcher.html", "icons": [{ "src": "../img/cw-dispatch-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "dispatcher.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
